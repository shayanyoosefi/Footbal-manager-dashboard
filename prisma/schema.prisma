generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  PLAYER
}

enum QuestionType {
  PREDEFINED
  CUSTOM
}

enum AssignmentStatus {
  PENDING
  ANSWERED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Manager owns players in their squad
  managedPlayers PlayerProfile[] @relation("ManagerPlayers")

  // Player profile (when role is PLAYER)
  playerProfile PlayerProfile? @relation("PlayerUser")

  // Questions created by manager
  customQuestions QuestionTemplate[] @relation("QuestionAuthor")

  // Assignments sent by manager
  assignmentsSent QuestionAssignment[] @relation("AssignmentManager")
}

model PlayerProfile {
  id        String   @id @default(cuid())
  position  String?
  squad     String?
  jerseyNo  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String @unique
  user      User   @relation("PlayerUser", fields: [userId], references: [id], onDelete: Cascade)

  managerId String
  manager   User   @relation("ManagerPlayers", fields: [managerId], references: [id], onDelete: Cascade)

  assignments QuestionAssignment[]
}

model QuestionTemplate {
  id        String       @id @default(cuid())
  text      String
  category  String?
  type      QuestionType @default(PREDEFINED)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  authorId String?
  author   User?   @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  assignments QuestionAssignment[]
}

model QuestionAssignment {
  id        String           @id @default(cuid())
  status    AssignmentStatus @default(PENDING)
  dueDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  managerId String
  manager   User   @relation("AssignmentManager", fields: [managerId], references: [id], onDelete: Cascade)

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  questionId String
  question   QuestionTemplate @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answer Answer?

  @@index([playerId, status])
  @@index([managerId])
}

model Answer {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentId String             @unique
  assignment   QuestionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}
