# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth — required in production (Vercel: add in Project → Settings → Environment Variables)
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Vercel production example (use Postgres, not SQLite):
# DATABASE_URL="postgresql://..."
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="<paste output of: openssl rand -base64 32>"
